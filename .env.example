# Referencia. setup.sh genera .env automáticamente con valores aleatorios.
SNACKDROP_HTTP_PORT=28743
SNACKDROP_SECRET_KEY=<64 caracteres aleatorios>
SNACKDROP_ADMIN_USERNAME=admin
SNACKDROP_ADMIN_PASSWORD=<aleatoria, solo para la primera instalación>
SNACKDROP_LOCAL_NODE_TOKEN=sdn_<aleatorio>
SNACKDROP_LOCAL_NODE_NAME=master
SNACKDROP_COOKIE_SECURE=false
SNACKDROP_SESSION_TTL_MINUTES=720
SNACKDROP_MAX_UPLOAD_MB=8192
SNACKDROP_MAX_FILES_PER_JOB=500
SNACKDROP_RETENTION_DAYS=7
SNACKDROP_DELETE_INPUTS_ON_FINISH=true
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
